<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_toolbar">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2190"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your Profile"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="?"
                    android:textColor="@color/text_on_accent"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar_large" />

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Your avatar" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change photo"
                android:textColor="@color/accent_link"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Display name"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="How others see you"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:inputType="textCapWords|textPersonName" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@username"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/text_on_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your photo and name are encrypted before being sent. Each contact receives an encrypted copy of the key needed to view your photo."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="28dp"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theme: System"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="14dp"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnReadReceipts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send read receipts: On"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="14dp"
                android:background="@drawable/bg_input" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
